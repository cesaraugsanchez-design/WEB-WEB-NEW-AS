# Copiar a `.env.local` para desarrollo, y definir estas mismas variables en el
# panel de Vercel (Settings -> Environment Variables) para produccion.
#
# NUNCA subir el archivo con los valores reales: `.gitignore` ya excluye .env*

# Obligatoria. Se crea en https://resend.com/api-keys
RESEND_API_KEY=

# Opcional. Buzon que RESPONDE las solicitudes del formulario de contacto.
# Por defecto recepcion@assanch.com
CONTACTO_DESTINO=
# Opcional. Buzones en copia, separados por comas. Ven la solicitud pero no
# son quien contesta. Si se deja vacio, el codigo usa estos dos:
#   csanchez@assanch.com, ca.sanchez@assanch.com
# Definir con valor vacio para no mandar copia a nadie.
CONTACTO_COPIA=

# Opcional. Debe pertenecer a un dominio verificado en Resend.
# Mientras assanch.com no este verificado, usar onboarding@resend.dev
CONTACTO_REMITENTE=

# Opcional. Buzones que reciben los reclamos, separados por comas.
# Si se deja vacio, el codigo usa estos tres:
#   recepcion@assanch.com, ca.sanchez@assanch.com, csanchez@assanch.com
# Solo hace falta definirla para CAMBIAR esa lista.
RECLAMOS_DESTINO=

# --- Interna (tablero de metricas) ---
# Aplicacion registrada en Microsoft Entra ID. Con las tres definidas, el
# tablero lee la matriz viva de SharePoint. Sin ellas, cae a MATRIZ_LOCAL.
# Ya NO se usa para iniciar sesion: el acceso es correo de la firma +
# contraseña propia (ver KV_REST_API_* abajo).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Solo para desarrollo: ruta a una copia .xlsx de la matriz en disco.
MATRIZ_LOCAL=

# Firma de la cookie de sesion de Interna. Cadena aleatoria larga, distinta en
# cada entorno. Generar con: openssl rand -base64 48
SESION_SECRETO=

# Opcional. Dominios de correo que pueden crear cuenta, separados por comas.
# Por defecto: assanch.com
INTERNA_DOMINIOS=

# Almacen de cuentas de Interna (Upstash Redis). La integracion de Vercel
# (Storage > Upstash Redis) las crea sola al conectar la base al proyecto.
# Tambien se aceptan UPSTASH_REDIS_REST_URL y UPSTASH_REDIS_REST_TOKEN.
# Sin ellas, en produccion nadie puede entrar; en desarrollo se usa memoria.
# El enlace para fijar contraseña sale por Resend (RESEND_API_KEY, arriba).
KV_REST_API_URL=
KV_REST_API_TOKEN=
