# Copiar a `.env.local` para desarrollo, y definir estas mismas variables en el
# panel de Vercel (Settings -> Environment Variables) para produccion.
#
# NUNCA subir el archivo con los valores reales: `.gitignore` ya excluye .env*

# Obligatoria. Se crea en https://resend.com/api-keys
RESEND_API_KEY=

# Opcional. Por defecto recepcion@assanch.com
CONTACTO_DESTINO=

# Opcional. Debe pertenecer a un dominio verificado en Resend.
# Mientras assanch.com no este verificado, usar onboarding@resend.dev
CONTACTO_REMITENTE=

# Opcional. Buzones que reciben los reclamos, separados por comas.
# Si se deja vacio, el codigo usa estos tres:
#   recepcion@assanch.com, ca.sanchez@assanch.com, csanchez@assanch.com
# Solo hace falta definirla para CAMBIAR esa lista.
RECLAMOS_DESTINO=
